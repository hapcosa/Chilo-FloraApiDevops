{
  "info": {
    "name": "Auth Service - Direct Connection",
    "description": "Conexión directa al auth service en puerto 8081 (sin gateway)",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "auth_host",
      "value": "http://localhost:8081",
      "description": "Host directo del auth service"
    },
    {
      "key": "access_token",
      "value": "",
      "description": "JWT access token"
    },
    {
      "key": "refresh_token",
      "value": "",
      "description": "JWT refresh token"
    },
    {
      "key": "user_id",
      "value": "",
      "description": "ID del usuario logueado"
    },
    {
      "key": "test_email",
      "value": "direct@test.com",
      "description": "Email de prueba"
    },
    {
      "key": "test_password",
      "value": "DirectTest123!",
      "description": "Password de prueba"
    }
  ],
  "item": [
    {
      "name": "🏥 Health Checks",
      "item": [
        {
          "name": "Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{auth_host}}/health",
              "host": ["{{auth_host}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Service Ready",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{auth_host}}/ready",
              "host": ["{{auth_host}}"],
              "path": ["ready"]
            }
          }
        },
        {
          "name": "Service Alive",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{auth_host}}/alive",
              "host": ["{{auth_host}}"],
              "path": ["alive"]
            }
          }
        },
        {
          "name": "Service Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{auth_host}}/metrics",
              "host": ["{{auth_host}}"],
              "path": ["metrics"]
            }
          }
        },
        {
          "name": "API Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{auth_host}}/api/v1/health",
              "host": ["{{auth_host}}"],
              "path": ["api", "v1", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "🔐 Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    if (response.access_token) {",
                  "        pm.environment.set('access_token', response.access_token);",
                  "        pm.environment.set('refresh_token', response.refresh_token);",
                  "        pm.environment.set('user_id', response.user.id);",
                  "    }",
                  "}"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const timestamp = Date.now();",
                  "const email = `direct${timestamp}@test.com`;",
                  "pm.environment.set('test_email', email);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\",\n  \"name\": \"Direct Test User\"\n}"
            },
            "url": {
              "raw": "{{auth_host}}/api/v1/auth/register",
              "host": ["{{auth_host}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.access_token) {",
                  "        pm.environment.set('access_token', response.access_token);",
                  "        pm.environment.set('refresh_token', response.refresh_token);",
                  "        pm.environment.set('user_id', response.user.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
            },
            "url": {
              "raw": "{{auth_host}}/api/v1/auth/login",
              "host": ["{{auth_host}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.access_token) {",
                  "        pm.environment.set('access_token', response.access_token);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{auth_host}}/api/v1/auth/refresh",
              "host": ["{{auth_host}}"],
              "path": ["api", "v1", "auth", "refresh"]
            }
          }
        },
        {
          "name": "Verify Token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{auth_host}}/api/v1/auth/verify",
              "host": ["{{auth_host}}"],
              "path": ["api", "v1", "auth", "verify"]
            }
          }
        },
        {
          "name": "Who Am I",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{auth_host}}/api/v1/auth/whoami",
              "host": ["{{auth_host}}"],
              "path": ["api", "v1", "auth", "whoami"]
            }
          }
        }
      ]
    },
    {
      "name": "🔗 OAuth",
      "item": [
        {
          "name": "Google OAuth URL",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{auth_host}}/api/v1/auth/google",
              "host": ["{{auth_host}}"],
              "path": ["api", "v1", "auth", "google"]
            }
          }
        },
        {
          "name": "GitHub OAuth URL",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{auth_host}}/api/v1/auth/github",
              "host": ["{{auth_host}}"],
              "path": ["api", "v1", "auth", "github"]
            }
          }
        }
      ]
    },
    {
      "name": "👤 User Profile",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{auth_host}}/api/v1/auth/me",
              "host": ["{{auth_host}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Direct User\",\n  \"avatar\": \"https://example.com/avatar.jpg\"\n}"
            },
            "url": {
              "raw": "{{auth_host}}/api/v1/auth/me",
              "host": ["{{auth_host}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"{{test_password}}\",\n  \"new_password\": \"NewDirectTest123!\"\n}"
            },
            "url": {
              "raw": "{{auth_host}}/api/v1/auth/change-password",
              "host": ["{{auth_host}}"],
              "path": ["api", "v1", "auth", "change-password"]
            }
          }
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.environment.unset('access_token');",
                  "    pm.environment.unset('refresh_token');",
                  "    pm.environment.unset('user_id');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{auth_host}}/api/v1/auth/logout",
              "host": ["{{auth_host}}"],
              "path": ["api", "v1", "auth", "logout"]
            }
          }
        }
      ]
    }
  ]
}
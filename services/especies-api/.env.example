# ======================
# PRODUCTION CONFIGURATION
# ======================

# API Configuration
API_PORT=9080
API_HOST=0.0.0.0

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=chiloe_flora_db
DB_USER=postgres
DB_PASSWORD=postgres

# PGAdmin Configuration
PGADMIN_EMAIL=admin@chiloe.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=8888

# Object storage S3-compatible
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET_ESPECIES=especies-fotos
S3_BUCKET_AVISTAMIENTOS=avistamientos-fotos
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRES_SECONDS=900

# ======================
# DEVELOPMENT CONFIGURATION
# ======================

# Development API
API_PORT_DEV=9080

# Development Database
DB_HOST_DEV=postgres-dev
DB_PORT_DEV=5433
DB_NAME_DEV=chiloe_flora_dev
DB_USER_DEV=dev_user
DB_PASSWORD_DEV=dev_password

# Development PGAdmin
PGADMIN_PASSWORD_DEV=admin
PGADMIN_PORT_DEV=8889

# Development Services
REDIS_PORT_DEV=6379
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

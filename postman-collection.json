{
  "info": {
    "name": "Flora Chiloé - Auth Service via Gateway",
    "description": "Colección completa para el servicio de autenticación de Flora Chiloé usando nginx gateway",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost",
      "description": "Base URL del gateway nginx"
    },
    {
      "key": "auth_base",
      "value": "{{base_url}}/api/v1/auth",
      "description": "Base URL para rutas de auth"
    },
    {
      "key": "access_token",
      "value": "",
      "description": "JWT access token obtenido del login"
    },
    {
      "key": "refresh_token",
      "value": "",
      "description": "JWT refresh token obtenido del login"
    },
    {
      "key": "user_id",
      "value": "",
      "description": "ID del usuario logueado"
    },
    {
      "key": "test_email",
      "value": "test@florachiloe.cl",
      "description": "Email de prueba"
    },
    {
      "key": "test_password",
      "value": "TestPassword123!",
      "description": "Password de prueba"
    }
  ],
  "item": [
    {
      "name": "🏥 Health Checks",
      "description": "Endpoints para verificar el estado de los servicios",
      "item": [
        {
          "name": "Gateway Health",
          "request": {
            "method": "GET",

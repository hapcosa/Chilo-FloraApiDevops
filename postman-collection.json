          "response": []
        },
        {
          "name": "Auth Service Alive",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/alive",
              "host": ["{{base_url}}"],
              "path": ["alive"]
            },
            "description": "Liveness probe del auth service"
          },
          "response": []
        },
        {
          "name": "Service Metrics",
          "request": {
            "method": "GET",
            "header": [],

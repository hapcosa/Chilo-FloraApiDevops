{
  "service": "Chiloe Biodiversidad API Gateway",
  "environment": "development",
  "status": "running",
  "port": 8080,
  "endpoints": {
    "especies_api": [
      "GET /api/especies",
      "GET /api/especies/{id}",
      "GET /api/v1/especies",
      "GET /api/v1/especies/{id}",
      "POST /api/especies",
      "POST /api/v1/especies",
      "PUT /api/especies/{id}",
      "PUT /api/v1/especies/{id}",
      "DELETE /api/especies/{id}",
      "DELETE /api/v1/especies/{id}",
      "PATCH /api/v1/especies/{id}/fotos",
      "GET /api/v1/avistamientos",
      "GET /api/v1/avistamientos/{id}",
      "POST /api/v1/avistamientos",
      "PATCH /api/v1/avistamientos/{id}/moderacion",
      "GET /api/v1/avistamientos/{id}/identificaciones",
      "POST /api/v1/avistamientos/{id}/identificaciones",
      "DELETE /api/v1/avistamientos/{id}/identificaciones/{idIdentificacion}",
      "GET /api/familias",
      "GET /api/generos",
      "POST /api/v1/uploads/presign"
    ],
    "auth_service": [
      "POST /api/v1/auth/register",
      "POST /api/v1/auth/login",
      "POST /api/v1/auth/google",
      "POST /api/v1/auth/refresh",
      "GET /api/v1/auth/google",
      "GET /api/v1/auth/whoami"
    ],
    "health_checks": [
      "GET /health",
      "GET /api/health",
      "GET /ready",
      "GET /alive"
    ],
    "monitoring": [
      "GET /nginx_status",
      "GET /metrics",
      "GET /api/metrics"
    ],
    "documentation": [
      "GET /docs",
      "GET /docs-api.json"
    ]
  },
  "quick_tests": [
    "curl http://localhost:8080/health",
    "curl http://localhost:8080/api/health",
    "curl http://localhost:8080/docs-api.json"
  ]
}

# Plantilla del archivo de entorno de producción.
#
# El archivo REAL no vive en el repo. Se guarda fuera del árbol de git (por
# ejemplo /home/<usuario>/.config/chiloe-prod/chiloe.env, permisos 600) y se
# pasa con --env-file. Ver docs/deployment/PRODUCCION_DOCKER_CLOUDFLARE.md.
#
# Genera cada secreto nuevo. No reutilices los de desarrollo:
#   openssl rand -hex 32     # JWT_SECRET
#   openssl rand -base64 24  # contraseñas

# --- Postgres ---
DB_NAME=chiloe_biodiversidad
DB_USER=chiloe_prod
DB_PASSWORD=

# --- Auth ---
JWT_SECRET=
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=168h

# --- Object storage (MinIO) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
ESPECIES_FOTOS_BUCKET=especies-fotos
AVISTAMIENTOS_FOTOS_BUCKET=avistamientos-fotos
PERFILES_FOTOS_BUCKET=perfiles-fotos
S3_REGION=us-east-1
S3_PRESIGN_EXPIRES_SECONDS=900

# Hostname público de MinIO. Con esto se firman las URLs presignadas: si
# apuntara a un host interno, el teléfono no podría subir nada.
S3_PUBLIC_ENDPOINT=https://storage.piedrasdelrayadito.cl

# --- URLs públicas ---
PUBLIC_API_URL=https://api.piedrasdelrayadito.cl

# --- Cloudflare Tunnel ---
# UUID del túnel, que imprime `cloudflared tunnel create chiloe-api`. Va acá y
# no en cloudflared/config.yml porque es de la instalación, no del código.
CLOUDFLARED_TUNNEL_ID=<tunnel-uuid>
# Ruta ABSOLUTA en el host al JSON de credenciales que genera ese mismo
# comando; el archivo se llama <tunnel-uuid>.json.
CLOUDFLARED_CREDENTIALS_FILE=/home/<usuario>/.cloudflared/<tunnel-uuid>.json
# uid/gid del dueño de ese JSON (`id -u` / `id -g`). El contenedor corre con
# ellos para poder leer un secreto en modo 0600 sin aflojarle los permisos.
CLOUDFLARED_UID=1000
CLOUDFLARED_GID=1000

# --- Google Sign-In (opcional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
